{
  "name": "dsh-desktop",
  "version": "0.3.0",
  "description": "DeepSeek Harness 官方 Web 形态的 Electron 桌面壳（方案 A：spawn 官方 dsh web 子进程）",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "watch:plugins": "npm-run-all --parallel watch:dsh-term watch:dsh-file-manager watch:dsh-schedule-view watch:dsh-im-gateway watch:dsh-session-cleaner watch:dsh-skill-manage",
    "watch:dsh-term": "npm run watch --prefix extensions/dsh-term",
    "watch:dsh-file-manager": "npm run watch --prefix extensions/dsh-file-manager",
    "watch:dsh-schedule-view": "npm run watch --prefix extensions/dsh-schedule-view",
    "watch:dsh-im-gateway": "npm run watch --prefix extensions/im-gateway",
    "watch:dsh-session-cleaner": "npm run watch --prefix extensions/session-cleaner",
    "watch:dsh-skill-manage": "npm run watch --prefix extensions/dsh-skill-manage",
    "start": "electron .",
    "dev": "npm run build && npm-run-all -p watch:plugins start",
    "lint": "tsc --noEmit",
    "build:native": "node scripts/build-native.cjs",
    "fetch-node": "node scripts/fetch-node.cjs",
    "build:electron": "npm run verify-deps && npm run fetch-node && npm run build:native && npm run build && electron-builder",
    "build:electron:win": "node scripts/verify-deps.cjs && node scripts/fetch-node.cjs --win && node scripts/build-native.cjs --win && npm run build && electron-builder --win",
    "build:electron:mac": "node scripts/verify-deps.cjs && node scripts/fetch-node.cjs --mac && node scripts/build-native.cjs --mac && npm run build && electron-builder --mac --x64 --arm64",
    "pack": "npm run build:electron -- --dir",
    "dist": "npm run build:electron",
    "release:github": "node scripts/publish-github.mjs",
    "verify-deps": "node scripts/verify-deps.cjs"
  },
