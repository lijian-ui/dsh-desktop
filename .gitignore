# 依赖与构建产物
node_modules/
dist/
# 扩展包 tsdown 构建产物
extensions/**/lib/
# electron-builder 打包输出（安装包与解压目录）
dist-electron/

# Node 运行时（v0.2.0 内置 Node 集成）：
# node/   = 官方发行包（大二进制，本机构建用）
# vendor/ = 精简后的 Node 运行时（fetch-node.cjs 构建时生成）
node/
vendor/

# 日志
*.log

# 本地配置（可能包含 API Key 等敏感信息，切勿提交）
config.json

# 发版脚本（本机专用，不上传 GitHub；gh CLI 凭据由本机 keyring 提供）
scripts/publish-lib.mjs
scripts/publish-github.mjs

# 操作系统 / 编辑器
.DS_Store
.idea/
.vscode/
.codeartsdoer

# 第三方参考源码（pi-desk-top 等），不随仓库发布
参考项目/

# 项目记忆数据（本地）
.workbuddy/

# dsh 开发残留数据（sessions 等），非仓库内容
resources/dsh-home/

# extensions 为独立仓库（github.com/lijian-ui/dsh-im-gateway），桌面端通过 npm 依赖 @lijian-ui/dsh-im-gateway 引用
extensions/

# 临时调试/验证脚本（一次性使用，不纳入版本控制）
*.ps1