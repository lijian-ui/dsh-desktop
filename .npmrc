# 国内 npm 镜像（淘宝 npmmirror），加速依赖包安装
registry=https://registry.npmmirror.com/

# Electron 预编译二进制镜像：否则 npm install 会从 GitHub 下载，国内极慢/失败
# npmmirror 的 binary 镜像路径，末尾斜杠必填
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# 可选：若 dsh 的原生模块（node-pty / koffi）安装卡住，可放开下方注释用淘宝源
# node-pty 的二进制镜像（如需要）：
# node_pty_binary_host_mirror=https://registry.npmmirror.com/-/binary/node-pty/
